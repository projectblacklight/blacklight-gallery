<div id="slideshow" class="slideshow-presenter carousel slide">
  <!-- Wrapper for slides -->
  <div class="slideshow-inner carousel-inner">
    <%= render document_component.with_collection(document_presenters, counter_offset:) %>
  </div>

  <!-- Controls -->
  <button type="button" class="carousel-control-prev" data-bs-target="#slideshow" data-bs-slide="prev" aria-label="<%= t('blacklight.icon.chevron_left_previous_image') %>">
    <%= render Blacklight::Gallery::Icons::ChevronLeftComponent.new(aria_hidden: true) %>
  </button>
  <button type="button" class="carousel-control-next" data-bs-target="#slideshow" data-bs-slide="next" aria-label="<%= t('blacklight.icon.chevron_right_next_image') %>">
    <%= render Blacklight::Gallery::Icons::ChevronRightComponent.new(aria_hidden: true) %>
  </button>
</div>
